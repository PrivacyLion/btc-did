# SignedByMe API Configuration
# Phase 26 - Clean configuration (no server-side NOSTR keys)

# === Required ===

# Admin dashboard password (Basic Auth)
SBM_ADMIN_PASSWORD=change-me-to-secure-password

# OIDC signing key (RS256)
# Generate with: openssl genrsa -out oidc_private.pem 2048
OIDC_PRIVATE_KEY_PATH=/opt/sbm-api/keys/oidc_private.pem

# === Database ===

# SQLite database path
SBM_DB_PATH=/opt/sbm-api/signedby.db

# Clients configuration
CLIENTS_JSON=/opt/sbm-api/clients.json

# === NOSTR Relay ===

# Relay URL for audit events (read-only subscription for admin feed)
SBM_RELAY_URL=wss://relay.signedbyme.com

# === Payment Allocator (Section 7.2) ===

# Strike Business API key for monthly payouts
# Get from: https://dashboard.strike.me
STRIKE_BUSINESS_API_KEY=

# Minimum payout threshold (sats)
SBM_MIN_PAYOUT_SATS=1000

# Dry run mode for testing (true/false)
SBM_DRY_RUN=false

# === Optional ===

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# API host/port (usually behind reverse proxy)
API_HOST=127.0.0.1
API_PORT=8000
